# Keep the release archive to what Sublime actually loads. Package Control
# installs whatever the tag's zip contains, and GitHub builds that zip with
# git archive, which honours export-ignore.
.claude/            export-ignore
tests/              export-ignore
.gitattributes      export-ignore
.gitignore          export-ignore
diff.sublime-project export-ignore
TODO.txt            export-ignore
channel.json        export-ignore
repository.json     export-ignore
